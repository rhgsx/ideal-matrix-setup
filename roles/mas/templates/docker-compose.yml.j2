# Managed by Ansible — Matrix Authentication Service
name: matrix-mas

services:
  mas:
    image: ghcr.io/element-hq/matrix-authentication-service:{{ mas_version }}
    container_name: matrix-mas
    restart: unless-stopped
    network_mode: host

    user: "{{ matrix_uid }}:{{ matrix_gid }}"

    command: server --config /etc/mas/config.yaml

    volumes:
      - /etc/matrix/mas:/etc/mas:ro
      - /var/lib/matrix/mas:/var/lib/mas
      - /var/log/matrix/mas:/var/log/mas

    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"

    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://{{ workers_ip }}:{{ mas_port }}/_health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
