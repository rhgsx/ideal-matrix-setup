#     hostname: smtp.example.com
#     port: 587
#     username: smtp_user
#     password: smtp_password

#==============================================================================
# Клиентский интерфейс
#==============================================================================
branding:
  service_name: "{{ matrix_server_name }} Matrix"
  policy_uri: "https://{{ matrix_server_name }}/privacy"
  tos_uri: "https://{{ matrix_server_name }}/tos"

