#==============================================================================
# Политики регистрации
#==============================================================================
policy:
  wasm_module: /opt/mas/policy.wasm
  data:
    # Разрешить регистрацию (false = только администраторы создают аккаунты)
    registration_enabled: true
    # Можно добавить email_domain_allowlist: ["example.com"]

#==============================================================================
# Логирование
#==============================================================================
telemetry:
  tracing:
    exporter: none
  metrics:
    exporter: prometheus
    listen: "127.0.0.1:9093"
  logging:
    filter: "info,hyper=warn,tower_http=info"
