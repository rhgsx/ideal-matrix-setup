# Managed by Ansible — Element Web nginx config (внутри контейнера vectorim/element-web)
# Переопределяет /etc/nginx/conf.d/default.conf в образе
server {
    listen {{ element_nginx_port }};
    server_name {{ element_domain }};

    # Путь к статике Element внутри образа vectorim/element-web
    root /app;
    index index.html;

    # X-Real-IP от HAProxy
    real_ip_header X-Forwarded-For;
    set_real_ip_from {{ haproxy_ip }};

    # Security headers
    add_header X-Content-Type-Options  "nosniff"                        always;
    add_header X-Frame-Options         "SAMEORIGIN"                     always;
    add_header X-XSS-Protection        "1; mode=block"                  always;
    add_header Referrer-Policy         "strict-origin-when-cross-origin" always;

    # config.json — НЕ кэшируем (монтируется с хоста)
    location = /config.json {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires 0;
    }

    # Статика Element — агрессивное кэширование
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # SPA routing
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires 0;
    }

    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    access_log /var/log/nginx/element_access.log combined;
    error_log  /var/log/nginx/element_error.log warn;

    client_max_body_size 10m;
    keepalive_timeout 65;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml text/javascript;
    gzip_vary on;
    gzip_min_length 1024;
}
