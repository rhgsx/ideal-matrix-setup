# Managed by Ansible — Element Web (nginx + official image)
name: matrix-element

services:
  element:
    image: vectorim/element-web:v{{ element_version }}
    container_name: matrix-element
    restart: unless-stopped
    # bridge network достаточно — HAProxy обращается к element_ip:element_nginx_port
    network_mode: host

    # Монтируем кастомный config.json поверх дефолтного
    volumes:
      - /etc/matrix/element/config.json:/app/config.json:ro
      - /etc/matrix/element/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - /var/log/matrix/element:/var/log/nginx

    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"

    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://{{ element_ip }}:{{ element_nginx_port }}/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
