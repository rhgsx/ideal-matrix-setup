# Managed by Ansible — Coturn TURN/STUN server
# КРИТИЧНО: network_mode: host обязателен для TURN relay!
# Без него контейнер не сможет правильно определить relay IP за NAT.
name: matrix-coturn

services:
  coturn:
    image: coturn/coturn:latest
    container_name: matrix-coturn
    restart: unless-stopped
    # host network ОБЯЗАТЕЛЕН для корректной работы TURN:
    # - relay-ip привязывается к реальному интерфейсу хоста
    # - external-ip сообщается клиентам как публичный адрес
    # - relay UDP-порты открываются напрямую на хосте
    network_mode: host

    command: -c /etc/turnserver/turnserver.conf

    volumes:
      - /etc/matrix/coturn:/etc/turnserver:ro
      - /etc/ssl/matrix:/etc/ssl/matrix:ro
      - /var/lib/matrix/coturn:/var/lib/coturn
      - /var/log/matrix/coturn:/var/log/coturn

    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"

    ulimits:
      nofile:
        soft: 65536
        hard: 65536
