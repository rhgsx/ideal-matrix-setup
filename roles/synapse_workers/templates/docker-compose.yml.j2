# Managed by Ansible — Synapse Workers ({{ synapse_workers | length }} containers)
# Все воркеры используют один и тот же образ Synapse, разные конфиги
name: matrix-workers

services:
{% for worker in synapse_workers %}
  {{ worker.name }}:
    image: ghcr.io/element-hq/synapse:v{{ synapse_version }}
    container_name: synapse-{{ worker.name }}
    restart: unless-stopped
    # host network — воркер слушает непосредственно на {{ workers_ip }}:{{ worker.port }}
    network_mode: host

    user: "{{ matrix_uid }}:{{ matrix_gid }}"

    # Запускаем конкретный worker app с двумя конфигами:
    # 1. Базовый homeserver.yaml (секреты, DB, Redis, stream_writers)
    # 2. Worker-специфичный конфиг (listener, worker_name, worker_app)
    command:
      - python3
      - -m
      - "{{ worker.app }}"
      - --config-path={{ synapse_config_dir }}/homeserver.yaml
      - --config-path={{ workers_config_dir }}/{{ worker.name }}.yaml

    environment:
      PYTHONDONTWRITEBYTECODE: "1"

    volumes:
      # Общие конфиги (read-only)
      - {{ synapse_config_dir }}:{{ synapse_config_dir }}:ro
      # Worker-специфичные конфиги (read-only)
      - {{ workers_config_dir }}:{{ workers_config_dir }}:ro
      # Данные — нужен media worker для media_store
      - {{ synapse_data_dir }}:{{ synapse_data_dir }}
      # Логи
      - {{ workers_log_dir }}:{{ workers_log_dir }}

    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"

{% if 'client' in (worker.worker_listeners | map(attribute='resources') | flatten)
   or 'federation' in (worker.worker_listeners | map(attribute='resources') | flatten) %}
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://{{ workers_ip }}:{{ worker.port }}/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
{% endif %}

    ulimits:
      nofile:
        soft: 65536
        hard: 65536

{% endfor %}
