[Unit]
Description=Synapse Worker — %i
Documentation=https://matrix-org.github.io/synapse/latest/workers.html
After=network.target matrix-synapse.service redis-server.service
PartOf=matrix-synapse-workers.target

[Service]
Type=notify
NotifyAccess=main
User={{ matrix_user }}
Group={{ matrix_group }}
WorkingDirectory={{ synapse_data_dir }}
Environment=WORKER_NAME=%i
ExecStart=/usr/bin/python3 -m synapse.app.generic_worker \
    --config-path {{ synapse_config_dir }}/homeserver.yaml \
    --config-path {{ workers_config_dir }}/%i.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGINT

RuntimeDirectory=matrix-synapse-worker-%i
RuntimeDirectoryMode=0755

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ synapse_data_dir }} {{ workers_log_dir }} /var/run
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

LimitNOFILE=65536
LimitNPROC=65536

[Install]
WantedBy=matrix-synapse-workers.target
