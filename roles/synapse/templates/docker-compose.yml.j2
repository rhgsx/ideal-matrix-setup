# Managed by Ansible — Synapse main process
name: matrix-synapse

services:
  synapse:
    image: ghcr.io/element-hq/synapse:v{{ synapse_version }}
    container_name: matrix-synapse
    restart: unless-stopped
    # host network — Synapse слушает на {{ synapse_ip }}:{{ synapse_http_port }}
    # так же как было бы при нативной установке
    network_mode: host

    user: "{{ matrix_uid }}:{{ matrix_gid }}"

    environment:
      SYNAPSE_CONFIG_PATH: "{{ synapse_config_dir }}/homeserver.yaml"
      # Отключаем встроенный генератор конфига образа — конфиг уже есть
      SYNAPSE_SERVER_NAME: "{{ matrix_server_name }}"
      SYNAPSE_REPORT_STATS: "no"

    volumes:
      # Конфиги (read-only)
      - {{ synapse_config_dir }}:{{ synapse_config_dir }}:ro
      # Данные (media, uploads, signing key)
      - {{ synapse_data_dir }}:{{ synapse_data_dir }}
      # Логи
      - {{ synapse_log_dir }}:{{ synapse_log_dir }}

    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "5"

    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://{{ synapse_ip }}:{{ synapse_http_port }}/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

    ulimits:
      nofile:
        soft: 65536
        hard: 65536
