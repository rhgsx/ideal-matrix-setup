[Unit]
Description=Synapse Matrix homeserver (main process)
Documentation=https://matrix-org.github.io/synapse/
After=network.target postgresql.service redis-server.service
Requires=network.target

[Service]
Type=notify
NotifyAccess=main
User={{ matrix_user }}
Group={{ matrix_group }}
WorkingDirectory={{ synapse_data_dir }}
ExecStart=/usr/bin/python3 -m synapse.app.homeserver \
    --config-path {{ synapse_config_dir }}/homeserver.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGINT

RuntimeDirectory=matrix-synapse
RuntimeDirectoryMode=0755

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ synapse_data_dir }} {{ synapse_log_dir }} /var/run/matrix-synapse
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

LimitNOFILE=65536
LimitNPROC=65536

[Install]
WantedBy=multi-user.target
