# Managed by Ansible — LiveKit SFU + JWT service
# КРИТИЧНО: network_mode: host обязателен для WebRTC ICE!
# LiveKit должен видеть реальные сетевые интерфейсы для медиа-трафика.
name: matrix-livekit

services:
  livekit:
    image: livekit/livekit-server:v{{ livekit_version }}
    container_name: matrix-livekit
    restart: unless-stopped
    # host network ОБЯЗАТЕЛЕН для WebRTC:
    # - ICE candidates используют реальный IP хоста
    # - UDP порты (7882) открываются напрямую на хосте
    # - NAT mapping (nat_1_to_1_ips) работает корректно
    network_mode: host

    command: --config /etc/livekit/livekit.yaml

    volumes:
      - /etc/matrix/livekit/livekit.yaml:/etc/livekit/livekit.yaml:ro
      - /var/lib/matrix/livekit:/var/lib/livekit
      - /var/log/matrix/livekit:/var/log/livekit

    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "5"

    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://{{ livekit_ip }}:{{ livekit_port }}/metrics || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s

    ulimits:
      nofile:
        soft: 65536
        hard: 65536

  lk-jwt:
    image: ghcr.io/element-hq/lk-jwt-service:latest
    container_name: matrix-lk-jwt
    restart: unless-stopped
    network_mode: host
    depends_on:
      livekit:
        condition: service_healthy

    env_file:
      - /etc/matrix/livekit/lk-jwt.env

    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"
