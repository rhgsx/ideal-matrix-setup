[Unit]
Description=LiveKit SFU Server
Documentation=https://docs.livekit.io/
After=network.target redis-server.service
Requires=network.target

[Service]
Type=simple
User=livekit
Group=livekit
WorkingDirectory=/var/lib/livekit
ExecStart=/usr/local/bin/livekit-server \
    --config {{ livekit_config_dir }}/livekit.yaml
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60
TimeoutStopSec=30

ReadWritePaths={{ livekit_log_dir }} /var/lib/livekit
NoNewPrivileges=yes
PrivateTmp=yes

# LiveKit нужны реальные привилегии для сетевых операций
AmbientCapabilities=CAP_NET_BIND_SERVICE

LimitNOFILE=65536
LimitNPROC=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=livekit

[Install]
WantedBy=multi-user.target
