[Unit]
Description=LiveKit JWT Service (Matrix Element Call)
Documentation=https://github.com/element-hq/lk-jwt-service
After=network.target livekit.service
Requires=livekit.service

[Service]
Type=simple
User=livekit
Group=livekit
EnvironmentFile={{ livekit_config_dir }}/lk-jwt.env
ExecStart=/usr/local/bin/lk-jwt-service
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

LimitNOFILE=16384

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lk-jwt

[Install]
WantedBy=multi-user.target
